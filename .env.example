# Local development
PERFORMANCELAB_ENV=local

# Private alpha
#
# Configure these values in the hosting provider's secret
# settings. Do not place the real DATABASE_URL in this file.
#
# PERFORMANCELAB_ENV=alpha
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

# Training Coach availability and usage limits
TRAINING_COACH_ENABLED=true
TRAINING_COACH_USER_DAILY_LIMIT=5
TRAINING_COACH_GLOBAL_DAILY_LIMIT=50


# Private alpha retention
#
# Every value is a number of days. These settings have no
# application defaults and must be decided before the alpha.
#
# RETENTION_INACTIVE_ACCOUNT_DAYS=<DAYS>
# RETENTION_INACTIVITY_NOTICE_DAYS=<DAYS>
# RETENTION_TRAINING_COACH_USAGE_DAYS=<DAYS>
# RETENTION_CONSENT_EVIDENCE_DAYS=<DAYS>
# RETENTION_UNUSED_INVITATION_DAYS=<DAYS>
# RETENTION_EXPIRED_INVITATION_DAYS=<DAYS>
# RETENTION_APPLICATION_LOG_DAYS=<DAYS>
# RETENTION_ERROR_ALERT_DAYS=<DAYS>
# RETENTION_BACKUP_DAYS=<DAYS>
# RETENTION_SUPPORT_REQUEST_DAYS=<DAYS>
# RETENTION_POST_ALPHA_DAYS=<DAYS>