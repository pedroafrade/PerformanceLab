# Local development
PERFORMANCELAB_ENV=local

# Private alpha
#
# Configure these values in the hosting provider's secret
# settings. Do not place the real DATABASE_URL in this file.
#
# PERFORMANCELAB_ENV=alpha
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

# Training Coach availability and usage limits
TRAINING_COACH_ENABLED=true
TRAINING_COACH_USER_DAILY_LIMIT=5
TRAINING_COACH_GLOBAL_DAILY_LIMIT=50


# Private alpha retention
#
# Approved retention periods for the private alpha.
# Every value is expressed in days. The alpha environment
# refuses to start if these values are missing or changed.
#
# RETENTION_INACTIVE_ACCOUNT_DAYS=90
# RETENTION_INACTIVITY_NOTICE_DAYS=14
# RETENTION_TRAINING_COACH_USAGE_DAYS=30
# RETENTION_CONSENT_EVIDENCE_DAYS=0
# RETENTION_UNUSED_INVITATION_DAYS=14
# RETENTION_EXPIRED_INVITATION_DAYS=7
# RETENTION_APPLICATION_LOG_DAYS=14
# RETENTION_ERROR_ALERT_DAYS=30
# RETENTION_BACKUP_DAYS=14
# RETENTION_SUPPORT_REQUEST_DAYS=90
# RETENTION_POST_ALPHA_DAYS=30