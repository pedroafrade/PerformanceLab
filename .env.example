# Local development
PERFORMANCELAB_ENV=local

# Private alpha
#
# Configure these values in the hosting provider's secret
# settings. Do not place the real DATABASE_URL in this file.
#
# PERFORMANCELAB_ENV=alpha
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE

# Training Coach usage limits
TRAINING_COACH_USER_DAILY_LIMIT=5
TRAINING_COACH_GLOBAL_DAILY_LIMIT=50