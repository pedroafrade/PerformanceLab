# Copie este ficheiro para alpha.auto.tfvars e substitua apenas os exemplos.
# O ficheiro copiado e ignorado pelo Git.

project_id              = "performancelab-alpha-example"
region                  = "europe-west1"
privacy_contact_email   = "privacy@example.com"
support_contact_email   = "support@example.com"
training_coach_enabled  = false

# Primeira fase: manter ambos false. Para obter o URL necessario ao OIDC,
# ative temporariamente apenas bootstrap_application. Depois de preencher os
# segredos, desative o bootstrap e ative deploy_application.
bootstrap_application = false
deploy_application    = false
container_image       = ""
